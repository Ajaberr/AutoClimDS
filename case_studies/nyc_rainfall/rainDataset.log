# Complete the comprehensive analysis report
import pandas as pd
import numpy as np
from scipy import stats

# Reload data for final analysis
rainfall_2021 = pd.read_csv('nyc_rainfall_2021.csv')
rainfall_2022 = pd.read_csv('nyc_rainfall_2022.csv')
rainfall_2023 = pd.read_csv('nyc_rainfall_2023.csv')
rainfall_data = pd.concat([rainfall_2021, rainfall_2022, rainfall_2023], ignore_index=True)
rainfall_data['date'] = pd.to_datetime(rainfall_data['date'])
rainfall_data['precipitation_mm'] = rainfall_data['value'] / 10.0

daily_precip = rainfall_data.groupby('date')['precipitation_mm'].sum().reset_index()
daily_precip = daily_precip.sort_values('date')

def classify_flood_risk(precip_mm):
    if precip_mm >= 100:
        return 'Extreme Risk'
    elif precip_mm >= 50:
        return 'High Risk'
    elif precip_mm >= 25:
        return 'Moderate Risk'
    elif precip_mm >= 10:
        return 'Low Risk'
    else:
        return 'Minimal Risk'

daily_precip['flood_risk'] = daily_precip['precipitation_mm'].apply(classify_flood_risk)

# Known flooding events analysis
